# ---- Runtime ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# ---- Database ----
# Matches docker-compose.yml. Use a separate database for automated tests (TEST_DATABASE_URL).
DATABASE_URL=postgresql://mytutor:mytutor@localhost:5432/mytutor?schema=public
TEST_DATABASE_URL=postgresql://mytutor:mytutor@localhost:5432/mytutor_test?schema=public

# ---- Sessions & security ----
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS=28800
# Comma-separated list of origins allowed to make state-changing requests.
# In development the Vite dev server runs on 5173 and proxies /api to the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# true in production (HTTPS). Must be true when NODE_ENV=production.
COOKIE_SECURE=false
# Set when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=false

# ---- Static frontend (production single-origin deployment) ----
# Path to the built web app. Empty disables static serving (development).
WEB_DIST_DIR=

# ---- Development seed only (never used in production) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only-123
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=ChangeMe-Dev-Only-123
