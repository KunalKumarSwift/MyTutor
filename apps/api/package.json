{
  "name": "@mytutor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "node -e \"if(process.env.NODE_ENV==='production'){console.error('db:reset is development-only');process.exit(1)}\" && prisma migrate reset && prisma db seed",
    "admin:create": "tsx --env-file-if-exists=../../.env scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/type-provider-typebox": "5.2.0",
    "@mytutor/contracts": "1.0.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "7.10.1",
    "@sinclair/typebox": "0.34.41",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "@types/pg": "8.15.6"
  }
}
