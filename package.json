{
  "name": "mytutor",
  "private": true,
  "version": "1.0.0",
  "description": "MyTutor — tutorial management and discovery platform (modernized).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @mytutor/api\" \"npm run dev -w @mytutor/web\"",
    "build": "npm run build -w @mytutor/contracts && npm run build -w @mytutor/api && npm run build -w @mytutor/web",
    "start": "npm run start -w @mytutor/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit -w @mytutor/api && npm run test -w @mytutor/web",
    "test:integration": "npm run test:integration -w @mytutor/api",
    "test:coverage": "npm run test:coverage -w @mytutor/api",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @mytutor/api",
    "db:migrate": "npm run db:migrate -w @mytutor/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @mytutor/api",
    "db:seed": "npm run db:seed -w @mytutor/api",
    "db:reset": "npm run db:reset -w @mytutor/api",
    "admin:create": "npm run admin:create -w @mytutor/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
